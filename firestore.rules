rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = custom claim `admin` trong token Firebase Auth (chỉ ASP0106).
    // Claim do server gán (scripts/security-bootstrap-admin.js), client không tự sửa được,
    // khác với trường employeeId / role trong `users` mà trước đây rules dựa vào.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Phiên đăng nhập bằng quét thẻ (thẻ chỉ có mã ASP, không mật khẩu): không được làm việc quản trị.
    function isScanSession() {
      return request.auth != null && request.auth.token.get('scan', false) == true;
    }

    // Quyền Xóa bật trong Settings (user-permissions chỉ admin ghi được).
    function hasDeletePermission() {
      return request.auth != null && !isScanSession() &&
        exists(/databases/$(database)/documents/user-permissions/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user-permissions/$(request.auth.uid)).data.get('hasDeletePermission', false) == true ||
          get(/databases/$(database)/documents/user-permissions/$(request.auth.uid)).data.get('hasEditPermission', false) == true
        );
    }

    // ===== Tài khoản & phân quyền =====

    // Hồ sơ: ai đăng nhập cũng đọc (tên/bộ phận hiển thị nhiều tab).
    // Tự sửa hồ sơ mình chỉ được tên, ảnh, giờ đăng nhập. employeeId / role / email chỉ admin hoặc server ghi.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        !('employeeId' in request.resource.data) &&
        !('password' in request.resource.data) &&
        request.resource.data.get('role', 'User') == 'User'
      );
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Quyền hạn: chỉ admin ghi. Tài khoản mới chỉ tự tạo được bản ghi KHÔNG có quyền gì.
    match /user-permissions/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('hasDeletePermission', false) == false &&
        request.resource.data.get('hasCompletePermission', false) == false &&
        request.resource.data.get('hasEditPermission', false) == false &&
        !('password' in request.resource.data)
      );
      allow update, delete: if isAdmin();
    }

    // Quyền từng tab: chỉ admin ghi. Tài khoản mới chỉ tự tạo được bản ghi có duy nhất tab Dashboard.
    match /user-tab-permissions/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.tabPermissions is map &&
        request.resource.data.tabPermissions.values().removeAll([false]).size() <= 1 &&
        request.resource.data.tabPermissions.get('dashboard', false) == true
      );
      allow update, delete: if isAdmin();
    }

    // Bảng quyền cũ (có lưu mật khẩu), không còn dùng: chỉ admin.
    match /local-user-permissions/{id} {
      allow read, write: if isAdmin();
    }

    // ===== Liên kết Zalo =====
    // OTP và mật khẩu mới gửi theo mã nhân viên trong zalo_links (bot ghi bằng Admin SDK).
    // Client chỉ đọc; chỉ admin xóa/sửa (tab Zalo) — chặn người khác trỏ mã ASP0106 về chat của mình.
    match /zalo_links/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /zalo_pending/{id} {
      allow read, write: if isAdmin();
    }

    // ===== Quản lý thiết bị kho =====

    function canManageEquipment() {
      return isAdmin() || hasDeletePermission();
    }

    // Danh mục thiết bị, nhân sự, hạng mục kiểm tra, ngày lễ: ai đăng nhập cũng đọc, chỉ người quản lý được ghi/xóa.
    match /warehouse-equipment/{id} {
      allow read: if request.auth != null;
      allow write: if canManageEquipment();
    }
    match /warehouse-equipment-staff/{id} {
      allow read: if request.auth != null;
      allow write: if canManageEquipment();
    }
    match /warehouse-equipment-meta/{id} {
      allow read: if request.auth != null;
      allow write: if canManageEquipment();
    }

    // Kết quả kiểm tra: người kiểm tra ghi được, nhưng phải đúng dạng dữ liệu; chỉ người quản lý được xóa.
    match /warehouse-equipment-inspections/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.equipmentId is string
        && request.resource.data.inspectionDate is string
        && request.resource.data.inspectionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.result in ['PASS', 'FAIL', 'NA', 'NOT_CHECKED'];
      allow delete: if canManageEquipment();
    }

    // Đánh dấu đã bảo dưỡng: ai đăng nhập cũng tick được.
    match /warehouse-equipment-maintenance/{id} {
      allow read, write: if request.auth != null;
    }

    // ===== Các collection khác =====
    // Giữ nguyên hành vi cũ (mọi tài khoản đã đăng nhập đọc/ghi được).
    // Firestore CỘNG quyền giữa các match, nên những collection có quy tắc riêng ở trên
    // phải được loại khỏi đây, nếu không quy tắc riêng sẽ vô tác dụng.
    function hasOwnRules(col) {
      return col in [
        'users',
        'user-permissions',
        'user-tab-permissions',
        'local-user-permissions',
        'zalo_links',
        'zalo_pending',
        'warehouse-equipment',
        'warehouse-equipment-staff',
        'warehouse-equipment-meta',
        'warehouse-equipment-inspections',
        'warehouse-equipment-maintenance'
      ];
    }

    match /{col}/{document=**} {
      allow read, write: if request.auth != null && !hasOwnRules(col);
    }
  }
}
